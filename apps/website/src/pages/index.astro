---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getArchiveProfiles, getNotes } from "../lib/content";
import { SITE_DESCRIPTION, withBase } from "../lib/site";

const notes = getNotes();
const profiles = getArchiveProfiles();
const featured = notes.filter((note) => note.tags.includes("featured")).slice(0, 3);
const recent = notes.slice(0, 6);
---

<BaseLayout>
  <section class="section hero">
    <p class="eyebrow">本地管理工具与公开笔记站</p>
    <h1>达芬奇的奇妙之旅</h1>
    <p class="lead">{SITE_DESCRIPTION}。记录在构建智能应用过程中的思考、实验与踩坑，分享可落地的技术方案与工程经验。</p>
    <div>
      <a class="button primary" href={withBase("/notes/")}>浏览笔记</a>
      <a class="button" href={withBase("/categories/")}>查看分类</a>
    </div>
  </section>

  <section class="section">
    <h2>精选笔记</h2>
    {featured.length === 0 ? (
      <p class="empty">还没有设为精选的公开笔记。第一篇正式笔记发布后会自动出现在这里。</p>
    ) : (
      <div class="grid">
        {featured.map((note) => (
          <a class="card" href={withBase(note.urlPath)}>
            <span class="pill">{note.category}</span>
            <h3>{note.title}</h3>
            <p>{note.description}</p>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <h2>最近更新</h2>
    {recent.length === 0 ? (
      <p class="empty">当前公开内容为空。请通过桌面管理工具发布经过确认的正式笔记。</p>
    ) : (
      <div class="grid">
        {recent.map((note) => (
          <a class="card" href={withBase(note.urlPath)}>
            <span class="pill">{note.topic || note.category}</span>
            <h3>{note.title}</h3>
            <p>{note.description}</p>
            <p class="meta">{note.updated || note.date}</p>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <h2>专题合集</h2>
    <div class="grid">
      {profiles.map((profile) => (
        <a class="card" href={withBase(`/categories/${encodeURIComponent(profile.category)}/`)}>
          <span class="pill">{profile.category}</span>
          <h3>{profile.name}</h3>
          <p class="meta">{profile.directory}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
