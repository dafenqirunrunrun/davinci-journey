---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNotes, getRecentNotes } from "../lib/content";
import { SITE_DESCRIPTION, withBase } from "../lib/site";

const notes = getNotes();
const recent = getRecentNotes(notes, 3);
---

<BaseLayout>
  <section class="hero">
    <h1>达芬奇的奇妙之旅</h1>
    <p class="lead">{SITE_DESCRIPTION}</p>
  </section>

  <section class="section notes-section" aria-labelledby="latest-notes-heading">
    <header class="section-head">
      <h2 id="latest-notes-heading">最新笔记</h2>
      {recent.length > 0 && (
        <a class="text-link" href={withBase("/notes/")}>查看全部 →</a>
      )}
    </header>
    {recent.length === 0 ? (
      <p class="empty">暂时还没有公开笔记。</p>
    ) : (
      <div class="note-list">
        {recent.map((note) => (
          <article class="note-list-item">
            <a class="note-list-link" href={withBase(note.urlPath)}>
              <h3>{note.title}</h3>
              <p class="note-list-description">{note.description}</p>
              <div class="note-list-meta">
                <span>{note.updated || note.date}</span>
                {note.tags.slice(0, 2).map((tag) => (
                  <span class="meta-item">· {tag}</span>
                ))}
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
