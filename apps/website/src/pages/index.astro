---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getNotes } from "../lib/content";
import { SITE_DESCRIPTION, withBase } from "../lib/site";

const notes = getNotes();
const recent = notes.slice(0, 4);
const featured = notes.filter((note) => note.featured).slice(0, 3);
const hasFeatured = featured.length > 0;
---

<BaseLayout>
  <section class="hero">
    <p class="eyebrow">AI Agent · RAG · LLM 工程实践</p>
    <h1>达芬奇的奇妙之旅</h1>
    <p class="lead">{SITE_DESCRIPTION}</p>
    <a class="button primary hero-cta" href={withBase("/notes/")}>浏览全部笔记</a>
  </section>

  <section class="section notes-section">
    <div class="section-head">
      <h2>最新笔记</h2>
      {recent.length > 0 && (
        <a class="text-link" href={withBase("/notes/")}>查看全部笔记 →</a>
      )}
    </div>
    {recent.length === 0 ? (
      <p class="empty">暂时还没有公开笔记。</p>
    ) : (
      <div class="grid">
        {recent.map((note) => (
          <a class="card note-card" href={withBase(note.urlPath)}>
            <span class="pill">{note.topic || note.category}</span>
            <h3>{note.title}</h3>
            <p class="card-desc">{note.description}</p>
            <div class="card-meta">
              <span class="updated">{note.updated || note.date}</span>
              {note.tags.slice(0, 2).map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    )}
  </section>

  {hasFeatured && (
    <section class="section notes-section">
      <div class="section-head">
        <h2>精选</h2>
      </div>
      <div class="grid">
        {featured.map((note) => (
          <a class="card note-card" href={withBase(note.urlPath)}>
            <span class="pill">{note.topic || note.category}</span>
            <h3>{note.title}</h3>
            <p class="card-desc">{note.description}</p>
            <div class="card-meta">
              <span class="updated">{note.updated || note.date}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
