---
import { REPOSITORY_URL, SITE_DESCRIPTION, SITE_NAME, withBase } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE_NAME, description = SITE_DESCRIPTION } = Astro.props;
const pageTitle = title === SITE_NAME ? SITE_NAME : `${title} | ${SITE_NAME}`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href={withBase("/rss.xml")} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={withBase("/")}>{SITE_NAME}</a>
      <nav aria-label="主导航">
        <a href={withBase("/")}>首页</a>
        <a href={withBase("/notes/")}>笔记</a>
        <a href={withBase("/categories/")}>分类</a>
        <a href={withBase("/tags/")}>标签</a>
        <a href={withBase("/about/")}>关于</a>
        <a href={withBase("/search/")}>搜索</a>
        <a href={REPOSITORY_URL}>GitHub</a>
      </nav>
      <button class="theme-toggle" type="button" aria-label="切换深色模式" data-theme-toggle>深色</button>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>{SITE_NAME}</span>
      <span>GitHub 是内容的唯一事实来源。</span>
    </footer>
    <script is:inline>
      const root = document.documentElement;
      const stored = localStorage.getItem("theme");
      if (stored === "dark" || (!stored && matchMedia("(prefers-color-scheme: dark)").matches)) {
        root.dataset.theme = "dark";
      }
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --bg: #ffffff;
    --surface: #f5f5f7;
    --text: #1d1d1f;
    --muted: #6e6e73;
    --border: rgba(0, 0, 0, 0.08);
    --accent: #0071e3;
    --accent-soft: #eaf3ff;
    --text-primary: #1d1d1f;
    --text-secondary: #6e6e73;
    --surface-subtle: #f5f5f7;
    --surface-code: rgba(0, 0, 0, 0.05);
    --border-subtle: rgba(0, 0, 0, 0.08);
    --border-strong: rgba(0, 0, 0, 0.16);
  }

  :root[data-theme="dark"] {
    color-scheme: dark;
    --bg: #000000;
    --surface: #1d1d1f;
    --text: #f5f5f7;
    --muted: #a1a1a6;
    --border: rgba(255, 255, 255, 0.12);
    --accent: #2997ff;
    --accent-soft: rgba(41, 151, 255, 0.16);
    --text-primary: #f5f5f7;
    --text-secondary: #a1a1a6;
    --surface-subtle: #1d1d1f;
    --surface-code: rgba(255, 255, 255, 0.08);
    --border-subtle: rgba(255, 255, 255, 0.12);
    --border-strong: rgba(255, 255, 255, 0.24);
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    line-height: 1.65;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px clamp(20px, 5vw, 72px);
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(20px);
  }

  .brand {
    font-weight: 700;
    letter-spacing: 0;
    white-space: nowrap;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 16px;
    color: var(--muted);
    font-size: 15px;
  }

  .theme-toggle,
  .button {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
    font: inherit;
    padding: 8px 14px;
  }

  .button.primary {
    border-color: var(--accent);
    background: var(--accent);
    color: #ffffff;
  }

  main {
    min-height: calc(100vh - 160px);
  }

  .section {
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    padding: 72px 0;
  }

  .hero {
    display: grid;
    gap: 24px;
    width: min(1120px, calc(100% - 40px));
    margin: 0 auto;
    padding-top: 72px;
    padding-bottom: 40px;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    max-width: 820px;
    font-size: clamp(3rem, 5vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.035em;
    overflow-wrap: anywhere;
  }

  .hero h1 {
    margin-bottom: 2px;
  }

  h2 {
    font-size: 30px;
    letter-spacing: 0;
  }

  .hero .lead {
    max-width: 42rem;
    color: var(--text-secondary);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    line-height: 1.75;
  }

  .lead {
    max-width: 720px;
    color: var(--muted);
    font-size: 18px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }

  .card {
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    padding: 22px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 16px;
  }

  .section-head h2 {
    margin-bottom: 0;
  }

  .text-link {
    color: var(--accent);
    font-size: 15px;
    white-space: nowrap;
  }

  /* Homepage latest-notes: white single-column list */
  .notes-section {
    padding-top: 40px;
  }

  .notes-section .section-head,
  .notes-section .note-list {
    max-width: 760px;
  }

  .note-list-item {
    border-bottom: 1px solid var(--border-subtle);
  }

  .note-list-item:last-child {
    border-bottom: 0;
  }

  .note-list-link {
    display: block;
    padding: 22px 4px;
    text-decoration: none;
    color: inherit;
    transition: color 160ms ease, background-color 160ms ease, transform 160ms ease;
  }

  .note-list-link:hover {
    color: var(--text-primary);
    background: var(--surface-subtle);
    transform: translateX(2px);
  }

  .note-list-link h3 {
    margin: 0 0 8px;
    font-size: clamp(1.25rem, 1.16rem + 0.4vw, 1.55rem);
    line-height: 1.35;
    font-weight: 650;
    transition: color 160ms ease;
  }

  .note-list-link:hover h3 {
    color: var(--accent);
  }

  .note-list-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 8px;
  }

  .note-list-description {
    margin: 0 0 10px;
    color: var(--text-secondary);
    font-size: 0.95em;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .note-list-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    color: var(--muted);
    font-size: 13px;
  }

  .meta-item {
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .note-list-link,
    .note-list-link h3 {
      transition: none;
    }

    .note-list-link:hover {
      transform: none;
    }
  }

  .meta,
  .empty {
    color: var(--muted);
  }

  .pill {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 14px;
    padding: 4px 10px;
  }

  .prose {
    max-width: 760px;
    margin: 0 auto;
    color: var(--text-primary);
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    line-height: 1.85;
  }

  .prose > .meta:first-child {
    margin-bottom: 10px;
  }

  .prose > h1:first-of-type {
    max-width: 760px;
    margin-bottom: 18px;
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  .prose .lead {
    margin-bottom: 18px;
    font-size: clamp(1rem, 0.96rem + 0.2vw, 1.125rem);
    line-height: 1.72;
    color: var(--text-secondary);
  }

  .prose h1,
  .prose h2,
  .prose h3,
  .prose h4 {
    max-width: 760px;
    letter-spacing: 0;
    line-height: 1.4;
  }

  .prose h1 {
    margin: 2.2em 0 0.9em;
    font-size: clamp(2rem, 4vw, 2.75rem);
    line-height: 1.25;
  }

  .prose h2 {
    margin: 2em 0 0.85em;
    font-size: clamp(1.65rem, 3vw, 2.15rem);
  }

  .prose h3 {
    margin: 1.6em 0 0.7em;
    font-size: clamp(1.25rem, 2vw, 1.55rem);
  }

  .prose h4 {
    margin: 1.4em 0 0.6em;
    font-size: 1.1rem;
  }

  .prose p {
    margin-block: 1.1em;
  }

  .prose ul,
  .prose ol {
    padding-inline-start: 1.5rem;
    margin-block: 1.1rem;
  }

  .prose li + li {
    margin-top: 0.45rem;
  }

  .prose blockquote {
    margin: 1.75rem 0;
    padding: 0.2rem 0 0.2rem 1.25rem;
    border-left: 3px solid var(--border-strong);
    color: var(--text-secondary);
  }

  .prose blockquote p:last-child {
    margin-bottom: 0;
  }

  .prose blockquote p {
    margin-block: 0.55em;
  }

  .prose table {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.75rem 0;
    font-size: 0.95em;
  }

  .prose th,
  .prose td {
    min-width: 8rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--border-subtle);
    text-align: left;
    vertical-align: top;
  }

  .prose th {
    background: var(--surface-subtle);
    font-weight: 600;
  }

  .prose :not(pre) > code {
    padding: 0.15em 0.4em;
    border-radius: 0.4rem;
    background: var(--surface-code);
    font-family: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    font-size: 0.9em;
  }

  .prose pre {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 1rem 1.1rem;
    font-size: 0.92em;
    line-height: 1.6;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .prose hr {
    margin: 3rem 0;
    border: 0;
    border-top: 1px solid var(--border-subtle);
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 16px;
  }

  .prose .mermaid-block {
    margin: 1.75rem 0;
    display: flex;
    justify-content: center;
    overflow-x: auto;
    padding: 0.25rem 0;
  }

  .prose .mermaid-block svg {
    max-width: 100%;
    height: auto;
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    padding: 30px clamp(20px, 5vw, 72px);
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 14px;
  }

  @media (max-width: 720px) {
    .site-header,
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }

    nav {
      justify-content: flex-start;
    }

    .section {
      width: min(100% - 28px, 1120px);
      padding: 40px 0;
    }

    .hero {
      width: min(100% - 36px, 1120px);
      padding-top: 48px;
      padding-bottom: 32px;
      gap: 16px;
    }

    .hero h1 {
      font-size: clamp(2.5rem, 12vw, 3.5rem);
    }

    .hero .lead {
      font-size: 16px;
    }

    .notes-section {
      padding-top: 24px;
    }

    .section-head {
      margin-bottom: 12px;
    }

    .note-list-link {
      padding: 20px 2px;
    }
  }
</style>
