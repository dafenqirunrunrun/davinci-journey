{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "达芬奇的奇妙之旅",
  "version": "0.1.0",
  "identifier": "com.davinci.journey",
  "build": {
    "beforeDevCommand": "pnpm exec vite --host 127.0.0.1 --port 4174",
    "devUrl": "http://127.0.0.1:4174",
    "beforeBuildCommand": "pnpm --filter @davinci-journey/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "达芬奇的奇妙之旅",
        "width": 1200,
        "height": 820
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
